SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Only needed once the app is served from a non-localhost origin (e.g. Render).
# Must include the scheme, e.g. https://fikirlab-backend.onrender.com
CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=idea_validator_db
POSTGRES_USER=idea_user
POSTGRES_PASSWORD=idea_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email delivery and authentication code policy
# The console backend is intended for local development only.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@example.com

# Brevo transactional email HTTP API. Leave empty locally to keep using
# EMAIL_BACKEND above (console). Required in production since Render blocks
# outbound SMTP.
BREVO_API_KEY=

AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_RESEND_COOLDOWN_SECONDS=60
AUTH_CODE_MAX_ATTEMPTS=5
# Set to the exact number of trusted reverse proxies in production.
DRF_NUM_PROXIES=0

# Gemini idea validation service
GEMINI_API_KEY=[GCP_API_KEY]
GEMINI_MODEL_NAME=gemini-3.1-flash-lite
